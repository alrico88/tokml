{
  "name": "geokml",
  "version": "2.0.0",
  "description": "Convert GeoJSON to KML with simplestyle support",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src test rslib.config.ts",
    "format": "biome format --write src rslib.config.ts",
    "prepare": "pnpm run build"
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alrico88/tokml.git"
  },
  "keywords": [
    "kml",
    "geojson",
    "geo",
    "maps"
  ],
  "author": "Alberto Rico",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@rslib/core": "^0.23.2",
    "@types/geojson": "^7946.0.16",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@sindresorhus/is": "^8.1.0",
    "defu": "^6.1.7"
  }
}
